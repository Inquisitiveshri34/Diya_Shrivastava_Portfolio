{
  "name": "diya-shrivastava-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Personal portfolio for Diya Shrivastava.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "media:manifest": "tsx scripts/build-media-manifest.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "predev": "npm run media:manifest",
    "prebuild": "npm run media:manifest && npm run validate:content",
    "lint": "eslint .",
    "prelint": "npm run media:manifest",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "npm run media:manifest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "check:links": "tsx scripts/check-links.ts",
    "lhci": "lhci autorun",
    "pretest:e2e": "npm run media:manifest"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "gray-matter": "4.0.3",
    "next": "16.4.6",
    "next-mdx-remote": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
